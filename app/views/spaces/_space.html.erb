<div id="<%= dom_id space %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Name:</strong>
    <%= space.name %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Space type:</strong>
    <%= space.space_type %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Description:</strong>
    <%= space.description %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Daily rate:</strong>
    <%= space.daily_rate %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Available:</strong>
    <%= space.available? ? "Yes" : "No" %>
  </div>
</div>
