
<% content_for :title, "Owner Console | Boothy" %>

<div class="space-y-8">

  <!-- Owner Console Header -->
  <div>
    <p class="text-xs text-[#70947A]">
      BOOTHY_OS / OWNER_CONSOLE /
      <%= @business.name.parameterize(separator: "_").upcase %>
    </p>

    <h1 class="mt-4 text-3xl font-bold text-[#8BF0A5] sm:text-4xl">
      &gt; <%= @business.name.upcase %>_
    </h1>

    <div class="mt-4 flex flex-wrap gap-3">
      <%= link_to "[ BUSINESS SETTINGS ]",
          edit_business_path(@business),
          class: "inline-block border border-[#8BF0A5] px-4 py-2 text-xs font-bold text-[#8BF0A5] hover:bg-[#203527]" %>

      <%= link_to "[ SWITCH BUSINESS ]",
          businesses_path,
          class: "inline-block border border-[#45634D] px-4 py-2 text-xs font-bold text-[#8BF0A5] hover:bg-[#203527]" %>
    </div>

    <p class="mt-4 text-sm text-[#B7CDBE]">
      <%= @business.business_type.to_s.upcase %> //
      SPACE MANAGEMENT TERMINAL
    </p>
  </div>

  <!-- Booth Statistics -->
  <div class="grid gap-4 sm:grid-cols-3">
    <% [
      ["TOTAL BOOTHS", @total_booths],
      ["OCCUPIED", @occupied_booths],
      ["AVAILABLE", @available_booths]
    ].each do |label, value| %>

      <div class="border border-[#45634D] bg-[#18251D] p-6">
        <p class="text-xs text-[#70947A]">
          <%= label %>
        </p>

        <p class="mt-4 text-4xl font-bold text-[#8BF0A5]">
          <%= value %>
        </p>
      </div>

    <% end %>
  </div>

  <!-- Monthly Financial Overview -->
  <section class="border border-[#45634D] bg-[#141E18] p-6 sm:p-8">

    <h2 class="text-xl font-bold text-[#8BF0A5]">
      + MONTHLY FINANCIAL OVERVIEW
    </h2>

    <div class="mt-8 grid gap-6 sm:grid-cols-2">

      <div>
        <p class="text-xs text-[#70947A]">
          MONTHLY RENTAL INCOME
        </p>

        <p class="mt-2 text-3xl font-bold text-[#8BF0A5]">
          <%= number_to_currency(@monthly_income) %>
        </p>
      </div>

      <div>
        <p class="text-xs text-[#70947A]">
          MONTHLY EXPENSES
        </p>

        <p class="mt-2 text-3xl font-bold text-[#F6B65E]">
          <%= number_to_currency(@monthly_expenses) %>
        </p>
      </div>

    </div>

    <!-- Expense Coverage -->
    <div class="mt-8">

      <div class="flex flex-wrap justify-between gap-2 text-xs">
        <span>EXPENSE COVERAGE</span>

        <span class="text-[#8BF0A5]">
          <%= @coverage_percentage %>%
        </span>
      </div>

      <div class="mt-3 h-5 overflow-hidden border border-[#45634D] bg-[#0B110D] p-1">
        <div
          class="h-full bg-[#8BF0A5] transition-all duration-300"
          style="width: <%= [[@coverage_percentage, 0].max, 100].min %>%">
        </div>
      </div>

      <% if @monthly_income >= @monthly_expenses %>

        <p class="mt-5 text-sm text-[#8BF0A5]">
          &gt; STATUS: EXPENSES COVERED
        </p>

        <p class="mt-2 text-sm">
          SURPLUS:
          +<%= number_to_currency(@monthly_income - @monthly_expenses) %>
        </p>

      <% else %>

        <p class="mt-5 text-sm text-[#F6B65E]">
          &gt; STATUS: FUNDING GAP
        </p>

        <p class="mt-2 text-sm">
          REMAINING:
          <%= number_to_currency(@monthly_expenses - @monthly_income) %>
        </p>

      <% end %>

    </div>

  </section>

  <!-- Financial Projections -->
  <section class="border border-[#45634D] bg-[#141E18] p-6 sm:p-8">

    <h2 class="text-xl font-bold text-[#8BF0A5]">
      + FINANCIAL PROJECTIONS
    </h2>

    <p class="mt-3 text-xs text-[#70947A]">
      ESTIMATED REVENUE AT FULL OCCUPANCY
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">

      <div>
        <p class="text-xs text-[#70947A]">
          CURRENT REVENUE
        </p>

        <p class="mt-3 text-2xl font-bold text-[#8BF0A5]">
          <%= number_to_currency(@monthly_income) %>
        </p>
      </div>

      <div>
        <p class="text-xs text-[#70947A]">
          ADDITIONAL POTENTIAL
        </p>

        <p class="mt-3 text-2xl font-bold text-[#F6B65E]">
          +<%= number_to_currency(@additional_potential_income) %>
        </p>
      </div>

      <div>
        <p class="text-xs text-[#70947A]">
          FULL OCCUPANCY REVENUE
        </p>

        <p class="mt-3 text-2xl font-bold text-[#8BF0A5]">
          <%= number_to_currency(@potential_income) %>
        </p>
      </div>

    </div>

    <!-- Potential Expense Coverage -->
    <div class="mt-8 border-t border-[#355640] pt-6">

      <div class="flex flex-wrap justify-between gap-3 text-xs">
        <span>POTENTIAL EXPENSE COVERAGE</span>

        <span class="text-[#8BF0A5]">
          <%= @potential_coverage_percentage %>%
        </span>
      </div>

      <div class="mt-3 h-5 overflow-hidden border border-[#45634D] bg-[#0B110D] p-1">
        <div
          class="h-full bg-[#8BF0A5]"
          style="width: <%= [[@potential_coverage_percentage, 0].max, 100].min %>%">
        </div>
      </div>

      <p class="mt-5 text-xs text-[#70947A]">
        &gt; PROJECTION ASSUMES ALL VACANT BOOTHS RENT
        AT THE DEFAULT MONTHLY FEE_
      </p>

    </div>

  </section>

  <!-- Interactive ASCII Floor Plan -->
  <section class="border border-[#45634D] bg-[#141E18] p-4 sm:p-8">

    <div class="flex flex-wrap items-center justify-between gap-3">

      <h2 class="text-xl font-bold text-[#8BF0A5]">
        + INTERACTIVE FLOOR PLAN
      </h2>

      <span class="text-xs text-[#70947A]">
        <%= @business.name.parameterize(separator: "_") %>.exe
      </span>

    </div>

    <p class="mt-4 text-xs text-[#70947A]">
      SELECT A BOOTH TO VIEW OR EDIT ITS DETAILS
    </p>

    <div class="mt-7 overflow-x-auto border border-[#355640] bg-[#0B110D] p-4 sm:p-6">

      <div class="mx-auto min-w-[280px] max-w-2xl font-mono">

        <p class="text-center text-xs text-[#8BF0A5]">
          +-------- <%= @business.name.upcase %> --------+
        </p>

        <!-- Booth Grid -->
        <div class="mt-6 grid grid-cols-3 gap-2 sm:gap-4">

          <% @booths.each do |booth| %>

            <% selected = @selected_booth&.id == booth.id %>

            <%= link_to owner_path(
                  business_id: @business.id,
                  booth: booth.number
                ),
                class: "block border p-2 text-center transition sm:p-4 #{selected ? 'border-[#8BF0A5] bg-[#203527]' : booth.occupied? ? 'border-[#45634D] hover:bg-[#18251D]' : 'border-[#8B6B39] hover:bg-[#292315]'}" do %>

              <div class="text-xs <%= booth.occupied? ? 'text-[#8BF0A5]' : 'text-[#F6B65E]' %>">

                <p>+-------+</p>

                <p>
                  | <%= booth.number.to_s.rjust(2, "0") %>    |
                </p>

                <p>+-------+</p>

              </div>

              <p class="mt-2 truncate text-[10px] font-bold sm:text-xs <%= booth.occupied? ? 'text-[#8BF0A5]' : 'text-[#F6B65E]' %>">
                <%= booth.vendor_name.presence || "EMPTY" %>
              </p>

              <% if selected %>
                <p class="mt-2 text-[10px] text-white">
                  ^ SELECTED
                </p>
              <% end %>

            <% end %>

          <% end %>

        </div>

        <div class="mt-8 border-t border-[#45634D] pt-4 text-center">
          <p class="text-xs text-[#70947A]">
            [ RECEPTION / MAIN ENTRANCE ]
          </p>
        </div>

      </div>

    </div>

    <!-- Selected Booth Details -->
    <% if @selected_booth %>

      <div class="mt-8 border border-[#45634D] bg-[#18251D] p-5 sm:p-7">

        <h3 class="text-lg font-bold text-[#8BF0A5]">
          &gt; BOOTH_<%= @selected_booth.number.to_s.rjust(2, "0") %> DETAILS
        </h3>

        <div class="mt-6 grid gap-5 text-sm sm:grid-cols-2">

          <div>
            <p class="text-xs text-[#70947A]">
              STATUS
            </p>

            <p class="mt-2 <%= @selected_booth.occupied? ? 'text-[#8BF0A5]' : 'text-[#F6B65E]' %>">
              <%= @selected_booth.occupied? ? "OCCUPIED" : "AVAILABLE" %>
            </p>
          </div>

          <div>
            <p class="text-xs text-[#70947A]">
              ASSIGNED VENDOR
            </p>

            <p class="mt-2">
              <%= @selected_booth.vendor_name.presence || "NONE" %>
            </p>
          </div>

        </div>

        <!-- Manage Vendor -->
        <div class="mt-7 border-t border-[#355640] pt-6">

          <h4 class="mb-5 text-sm font-bold text-[#8BF0A5]">
            + MANAGE VENDOR
          </h4>

          <%= form_with model: @selected_booth,
              url: booth_path(@selected_booth),
              method: :patch,
              class: "space-y-5" do |form| %>

            <div>
              <%= form.label :vendor_name,
                  "ASSIGNED VENDOR",
                  class: "block text-xs font-bold text-[#8BF0A5]" %>

              <%= form.text_field :vendor_name,
                  placeholder: "Enter vendor name",
                  class: "mt-3 w-full max-w-md border border-[#45634D] bg-[#0B110D] px-4 py-3 text-[#8BF0A5] outline-none focus:border-[#8BF0A5]" %>
            </div>

            <div>
              <%= form.label :monthly_fee,
                  "MONTHLY RENTAL FEE ($)",
                  class: "block text-xs font-bold text-[#8BF0A5]" %>

              <%= form.number_field :monthly_fee,
                  min: 0,
                  step: "0.01",
                  required: true,
                  class: "mt-3 w-full max-w-xs border border-[#45634D] bg-[#0B110D] px-4 py-3 text-[#8BF0A5] outline-none focus:border-[#8BF0A5]" %>
            </div>

            <%= form.submit "[ SAVE BOOTH DETAILS ]",
                class: "cursor-pointer border border-[#8BF0A5] bg-[#203527] px-5 py-3 text-sm font-bold text-[#8BF0A5] hover:bg-[#30563B]" %>

          <% end %>

          <!-- Remove Vendor -->
          <% if @selected_booth.occupied? %>

            <%= button_to "[ REMOVE VENDOR ]",
                booth_path(@selected_booth),
                method: :patch,
                params: {
                  booth: {
                    vendor_name: ""
                  }
                },
                form: {
                  data: {
                    turbo_confirm: "Remove this vendor from the booth?"
                  }
                },
                class: "mt-4 cursor-pointer border border-[#8B6B39] px-5 py-3 text-xs font-bold text-[#F6B65E] hover:bg-[#292315]" %>

          <% end %>

        </div>

        <p class="mt-5 text-xs text-[#70947A]">
          &gt; CHANGES WILL UPDATE MONTHLY REVENUE AUTOMATICALLY_
        </p>

      </div>

    <% else %>

      <div class="mt-8 border border-[#45634D] bg-[#18251D] p-6">

        <p class="text-sm text-[#F6B65E]">
          &gt; NO BOOTHS CONFIGURED_
        </p>

        <%= link_to "[ CONFIGURE BOOTH CAPACITY ]",
            edit_business_path(@business),
            class: "mt-4 inline-block border border-[#8BF0A5] px-4 py-2 text-xs font-bold text-[#8BF0A5] hover:bg-[#203527]" %>

      </div>

    <% end %>

    <p class="mt-6 text-xs text-[#70947A]">
      &gt; FLOOR PLAN SYSTEM ONLINE_
    </p>

  </section>

</div>
