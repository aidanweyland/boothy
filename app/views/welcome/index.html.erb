
<% content_for :title, "Boothy OS | Welcome" %>

<div class="mx-auto max-w-5xl space-y-10 py-8">

  <div class="space-y-3">
    <p class="text-sm text-[#8BF0A5]">
      BOOTHY_OS [VERSION 0.1]
    </p>

    <p class="text-xs text-[#70947A]">
      INITIALIZING WORKSPACE MANAGEMENT SYSTEM...
    </p>

    <h1 class="pt-6 text-5xl font-bold tracking-tight text-[#8BF0A5] sm:text-7xl">
      boothy_
    </h1>

    <p class="text-lg text-[#D6E5DA]">
      &gt; YOUR SPACE. YOUR NEXT CHAPTER.
    </p>

    <p class="text-sm text-[#70947A]">
      &gt; SELECT USER MODE TO CONTINUE_
    </p>
  </div>

  <div class="grid gap-5 md:grid-cols-2">

    <%= link_to owner_path, class: "group border border-[#45634D] bg-[#18251D] p-7 transition hover:border-[#8BF0A5] hover:bg-[#203527]" do %>

      <p class="text-sm text-[#8BF0A5]">
        +--------------------------+
      </p>

      <h2 class="mt-5 text-2xl font-bold text-[#8BF0A5]">
        [01] BUSINESS OWNER
      </h2>

      <p class="mt-5 text-sm leading-7 text-[#B7CDBE]">
        Manage your booths, vendors, rental income,
        and monthly expenses.
      </p>

      <p class="mt-8 text-sm font-bold text-[#8BF0A5]">
        &gt; ENTER OWNER MODE_
      </p>

    <% end %>

    <%= link_to vendor_path, class: "group border border-[#45634D] bg-[#18251D] p-7 transition hover:border-[#8BF0A5] hover:bg-[#203527]" do %>

      <p class="text-sm text-[#8BF0A5]">
        +--------------------------+
      </p>

      <h2 class="mt-5 text-2xl font-bold text-[#8BF0A5]">
        [02] VENDOR
      </h2>

      <p class="mt-5 text-sm leading-7 text-[#B7CDBE]">
        Access your rented workspace, view your booth,
        and check your monthly rental fee.
      </p>

      <p class="mt-8 text-sm font-bold text-[#8BF0A5]">
        &gt; ENTER VENDOR MODE_
      </p>

    <% end %>

  </div>

  <div class="border border-[#355640] bg-[#141E18] p-6 text-xs leading-7">
    <p class="font-bold text-[#8BF0A5]">SYSTEM INFORMATION</p>
    <p class="mt-3">STATUS: <span class="text-[#8BF0A5]">ONLINE</span></p>
    <p>ENVIRONMENT: DEMONSTRATION</p>
    <p>AUTHENTICATION: DISABLED</p>
    <p class="mt-3 text-[#70947A]">&gt; READY FOR INPUT_</p>
  </div>

</div>
