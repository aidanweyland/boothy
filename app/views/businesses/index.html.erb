
<% content_for :title, "Business Manager | Boothy" %>

<div class="space-y-8">

  <!-- Header -->
  <div class="flex flex-wrap items-center justify-between gap-4">

    <div>
      <p class="text-xs text-[#70947A]">
        BOOTHY_OS / BUSINESS_MANAGER
      </p>

      <h1 class="mt-4 text-3xl font-bold text-[#8BF0A5]">
        &gt; YOUR BUSINESSES_
      </h1>

      <p class="mt-3 text-sm text-[#B7CDBE]">
        MANAGE YOUR BUSINESS LOCATIONS AND RENTAL SPACES
      </p>
    </div>

    <%= link_to "[ + NEW BUSINESS ]",
        new_business_path,
        class: "border border-[#8BF0A5] px-5 py-3 text-xs font-bold text-[#8BF0A5] hover:bg-[#203527]" %>

  </div>

  <!-- Business Cards -->
  <div class="grid gap-5 md:grid-cols-2">

    <% @businesses.each do |business| %>

      <section class="border border-[#45634D] bg-[#18251D] p-6">

        <h2 class="text-xl font-bold text-[#8BF0A5]">
          <%= business.name.upcase %>
        </h2>

        <p class="mt-2 text-xs text-[#70947A]">
          <%= business.business_type.to_s.upcase %>
        </p>

        <div class="mt-6 space-y-3 text-sm">

          <p>
            TOTAL BOOTHS:
            <%= business.booths.count %>
          </p>

          <p>
            OCCUPIED:
            <%= business.occupied_booths.count %>
          </p>

          <p>
            AVAILABLE:
            <%= business.available_booths.count %>
          </p>

          <p class="text-[#8BF0A5]">
            MONTHLY INCOME:
            <%= number_to_currency(business.monthly_income) %>
          </p>

        </div>

        <div class="mt-6 flex flex-wrap gap-3">

          <%= link_to "[ OPEN CONSOLE ]",
              owner_path(business_id: business.id),
              class: "border border-[#8BF0A5] px-4 py-3 text-xs font-bold text-[#8BF0A5] hover:bg-[#203527]" %>

          <%= link_to "[ SETTINGS ]",
              edit_business_path(business),
              class: "border border-[#45634D] px-4 py-3 text-xs hover:bg-[#203527]" %>

        </div>

      </section>

    <% end %>

  </div>

  <% if @businesses.empty? %>

    <p class="text-sm text-[#F6B65E]">
      &gt; NO BUSINESSES FOUND. CREATE YOUR FIRST BUSINESS_
    </p>

  <% end %>

</div>
