
<% content_for :title, "New Business | Boothy" %>

<div class="mx-auto max-w-3xl space-y-8">

  <!-- Header -->
  <div>

    <%= link_to "< BUSINESS MANAGER",
        businesses_path,
        class: "text-xs text-[#8BF0A5] hover:underline" %>

    <h1 class="mt-6 text-3xl font-bold text-[#8BF0A5]">
      &gt; CREATE BUSINESS_
    </h1>

    <p class="mt-3 text-xs text-[#70947A]">
      REGISTER A NEW BUSINESS IN BOOTHY_OS
    </p>

  </div>

  <!-- Business Form -->
  <section class="border border-[#45634D] bg-[#141E18] p-6">

    <%= form_with model: @business, class: "space-y-6" do |form| %>

      <% if @business.errors.any? %>
        <div class="border border-[#8B6B39] p-4 text-[#F6B65E]">
          <%= @business.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= form.label :name, "BUSINESS NAME",
            class: "block text-xs text-[#70947A]" %>

        <%= form.text_field :name,
            required: true,
            class: "mt-2 w-full border border-[#45634D] bg-[#0B110D] p-3 text-[#8BF0A5]" %>
      </div>

      <div>
        <%= form.label :business_type, "BUSINESS TYPE",
            class: "block text-xs text-[#70947A]" %>

        <%= form.text_field :business_type,
            placeholder: "Salon, Retail, Tattoo Studio...",
            class: "mt-2 w-full border border-[#45634D] bg-[#0B110D] p-3 text-[#8BF0A5]" %>
      </div>

      <div>
        <%= form.label :monthly_expenses, "MONTHLY EXPENSES ($)",
            class: "block text-xs text-[#70947A]" %>

        <%= form.number_field :monthly_expenses,
            min: 0,
            step: "0.01",
            required: true,
            class: "mt-2 w-full border border-[#45634D] bg-[#0B110D] p-3 text-[#8BF0A5]" %>
      </div>

      <div>
        <%= form.label :default_monthly_fee,
            "DEFAULT MONTHLY BOOTH RENT ($)",
            class: "block text-xs text-[#70947A]" %>

        <%= form.number_field :default_monthly_fee,
            min: 0,
            step: "0.01",
            required: true,
            class: "mt-2 w-full border border-[#45634D] bg-[#0B110D] p-3 text-[#8BF0A5]" %>
      </div>

      <%= form.submit "[ CREATE BUSINESS ]",
          class: "cursor-pointer border border-[#8BF0A5] bg-[#203527] px-5 py-3 text-sm font-bold text-[#8BF0A5] hover:bg-[#30563B]" %>

    <% end %>

  </section>

  <p class="text-xs text-[#70947A]">
    &gt; AFTER CREATION, OPEN BUSINESS SETTINGS TO ADD BOOTHS_
  </p>

</div>
